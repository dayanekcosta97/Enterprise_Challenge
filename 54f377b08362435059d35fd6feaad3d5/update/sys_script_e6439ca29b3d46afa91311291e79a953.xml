        <script><![CDATA[(function () {
    var newStatus = current.getValue('status');
    if (newStatus === 'entregue') {
        if (!current.getValue('data_real_entrega')) {
            var now = new GlideDateTime();
            current.setValue('data_real_entrega', now.getValue());
        }
        current.setValue('ativo', 'false');
        current.setValue('ultima_atualizacao', new GlideDateTime().getValue());
    } else {
        // When status changes away from entregue, clear delivery date
        var previousStatus = previous.getValue('status');
        if (previousStatus === 'entregue') {
            current.setValue('data_real_entrega', '');
            current.setValue('ativo', 'true');
        }
    }
})();
]]></script>
