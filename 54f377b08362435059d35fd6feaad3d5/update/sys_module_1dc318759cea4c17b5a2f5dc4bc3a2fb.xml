        <content><![CDATA[import { GlideDateTime } from '@servicenow/glide';
export function setDefaultsEntrega(current) {
    current.setValue('status', 'pedido_criado');
    current.setValue('risco_atraso', 'baixo');
    current.setValue('ativo', 'true');
    var now = new GlideDateTime();
    current.setValue('ultima_atualizacao', now.getValue());
}
]]></content>
