    <name>Marcar como atrasada</name>
    <onclick/>
    <order>100</order>
    <script><![CDATA[var now = new GlideDateTime();
current.status = 'atrasado';
current.ultima_atualizacao = now;
current.risco_atraso = 'alto';
if (!current.motivo_risco || current.motivo_risco == '') {
    current.motivo_risco = 'Entrega marcada como atrasada manualmente';
}
current.update();

var trk = new GlideRecord('x_915815_smart_log_tracking');
trk.initialize();
trk.setValue('entrega', current.getUniqueValue());
trk.setValue('novo_status', 'atrasado');
trk.setValue('data_atualizacao', now.getValue());
trk.setValue('origem_atualizacao', 'manual');
trk.setValue('responsavel', gs.getUserID());
trk.insert();

action.setRedirectURL(current);]]></script>
